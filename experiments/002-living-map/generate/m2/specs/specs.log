experiments/002-living-map/golden-valley/places.json:32:      "blurb": "The innovation campus, on a field grid rebuilt at 22 degrees \u2014 inside the band that 35% of the box's surviving hedge length already runs in, so the new streets follow lines that are there rather than lines we liked. Twenty blocks of 38 by 17 m, four or five storeys, banded buff stone over a glazed ground floor. GCHQ sits on the skyline beyond, 100 m away and the whole point of the address. Nothing here is a tower: the scheme caps built ground at a third.",
experiments/002-living-map/golden-valley/places.json:70:      "blurb": "The whole proposition in one frame. Solar canopies in rows over a crop that is still being farmed \u2014 9.6 hectares of west-facing slope doing two jobs instead of choosing \u2014 and the glasshouses that take the campus's waste heat. Beyond them the orchard ring, 21.9 hectares of it, planted within 150 m of everything built so the edge of the scheme is trees rather than fence. This is what the third that is not built looks like.",
experiments/002-living-map/golden-valley/gv-paths.json:1:{"note":"Walkable routes in the Golden Valley box, as polylines rather than texels, so a path can be named, lit, chosen and walked. Points are local metres (x east, z south, origin at the box centre) and carry no height: the map drapes them on the same height field the terrain is built from. `named` routes come from OSM route relations and are the ones offered as destinations; `strand` routes are the rest of the network, chained through junctions, drawn as context.","generatedBy":"scripts/golden_valley_paths.py","source":"OpenStreetMap contributors, ODbL","frame":{"crs":"EPSG:27700","easting":[390400,392400],"northing":[221400,223400],"originEasting":391400.0,"originNorthing":222400.0},"stepMetres":4.0,"minStrandMetres":80.0,"counts":{"named":4,"strands":62,"landmarks":54,"kilometres":14.26,"points":3642},"routes":[{"id":"gloucestershire-cycle-spine","name":"Gloucestershire Cycle Spine","tier":"named","kind":"cycle","network":"lcn","lengthMetres":2298.3,"points":[[-979.65,186.4],[-977.13,189.5],[-974.6,192.61],[-972.08,195.71],[-969.33,198.61],[-966.49,201.42],[-963.64,204.23],[-960.79,207.04],[-957.95,209.85],[-955.1,212.66],[-952.25,215.47],[-949.4,218.28],[-946.73,221.23],[-944.62,224.63],[-942.52,228.03],[-940.42,231.43],[-938.31,234.83],[-936.21,238.24],[-934.1,241.64],[-932.0,245.04],[-929.54,248.19],[-927.01,251.28],[-924.48,254.38],[-921.95,257.48],[-919.43,260.59],[-916.9,263.69],[-914.37,266.79],[-911.85,269.89],[-909.31,272.98],[-906.77,276.07],[-904.23,279.16],[-901.69,282.25],[-899.14,285.34],[-896.6,288.43],[-894.06,291.52],[-891.52,294.6],[-888.98,297.69],[-886.43,300.78],[-883.85,303.83],[-881.27,306.89],[-878.69,309.95],[-876.11,313.01],[-873.54,316.07],[-870.75,318.93],[-867.82,321.65],[-864.89,324.37],[-861.96,327.1],[-859.03,329.82],[-855.97,332.39],[-852.86,334.91],[-849.76,337.44],[-846.66,339.96],[-843.55,342.48],[-840.45,345.0],[-837.34,347.53],[-834.11,349.88],[-830.81,352.14],[-827.51
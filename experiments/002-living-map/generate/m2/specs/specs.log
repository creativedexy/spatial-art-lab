+    },
+    {
+      "rank": 2,
+      "difference": "The plate courtyards are sparse grass with small faceted trees; the board courtyards are dense mature woodland rooms.",
+      "modellingAction": "Allocate veteran trees first, then irregular understory and multi-stem forms. Target 45 to 60 per cent canopy cover without obscuring the courtyard aperture.",
+      "system": "tree geometry/grade in landcover.js and future.js, plus gv-2045 tree data",
+      "effort": "1.5 days, covered by in-flight M5"
+    },
+    {
+      "rank": 3,
+      "difference": "Board roofs combine meadow, walkable routes and legible PV bands; plate roofs are nearly uniform green grids.",
+      "modellingAction": "Tune campus roof masks to approximately 40 per cent planted area, 35 per cent PV and 15 per cent readable paths or terraces on the foreground blocks, leaving service margins.",
+      "system": "roof shader in facades.js and roof allocation in scripts/golden_valley_2045.py",
+      "effort": "0.5 to 1 day"
+    },
+    {
+      "rank": 4,
+      "difference": "No continuous water edge reads in the plate; the board has a reflective channel and pond chain across the foreground.",
+      "modellingAction": "Use existing wetland and route classes to form two or three connected open-water reaches, with sky reflection and soft reed margins.",
+      "system": "gv-2045 land-cover data, ground shader in future.js and water in life.js",
+      "effort": "1 day, partly covered by in-flight M5"
+    },
+    {
+      "rank": 5,
+      "difference": "Plate vegetation uses one angular crown family and a narrow green range; board vegetation has broad, multi-stem and fine orchard forms with deep internal shadow.",
+      "modellingAction": "Replace the shared low-detail crown with four or five instanced silhouettes and tune lit/shaded grades separately. Do not attempt leaf-level geometry at 360 m.",
+      "system": "unitTree in landcover.js and KEYED_GRADE.trees in future.js",
+      "effort": "1 day, covered by in-flight M5"
+    },
+    {
+      "rank": 6,
+      "difference": "Plate ground has hard class boundaries and a uniform lawn cast; board ground is a fine mosaic of meadow, buff paths and planted beds.",
+      "modellingAction": "Soften class edges, add low-frequency meadow variation and separate courtyard hardscape from road asphalt.",
+      "system": "ground shader in future.js and gv-2045-landcover generation",
+      "effort": "0.5 day, covered by in-flight M5"
+    },
+    {
+      "rank": 7,
+      "difference": "The board camera and some block sizes drift from the plate, making the foreground buildings larger and GCHQ more prominent.",
+      "modellingAction": "Do not model this drift. Keep shots.json and the keyless plate geometry authoritative; take only palette, facade depth, roof mix and landscape character from the board.",
+      "system": "camera and geometry lock, no model change",
+      "effort": "none"
+    }
+  ]
+}
